Bootstrap: docker
From: ubuntu:22.04

%files
    ~/.ssh/id_rsa /root/.ssh/id_rsa
    ~/.ssh/id_rsa.pub /root/.ssh/id_rsa.pub

%post

# basic setup with non interactive command to facilitate installation
apt update && apt -y install git vim
DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends tzdata

# Configure SSH for GitHub (no password prompts)
mkdir -p /root/.ssh
chmod 700 /root/.ssh
chmod 600 /root/.ssh/id_rsa
# add girhub to known hosts (avoid "host key verification failed")
ssh-keyscan -H github.com >> /root/.ssh/known_hosts 2>/dev/null

# Tell git to use SSH instead of HTTPS
git config --global url."git@github.com:".insteadOf "https://github.com/"

# alias sudo to avoid issues in singularity
alias sudo=eval

# get arm learn, custom int version
git clone --recurse-submodules https://github.com/allpaul0/armlearn-wrapper.git
cd armlearn-wrapper
git checkout model 

# install dependencies
yes | . container/dependencies_installation.sh

# build wrapper
mkdir build && cd build && cmake .. && make Training